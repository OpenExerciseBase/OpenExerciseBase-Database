  "instructions": [
    {
      "stepNumber": 1,
      "description": "In a standing position, get on one leg and position other in a figure four position."
    },
    {
      "stepNumber": 2,
      "description": "Reach down and grab the ankle and knee of the non plant leg using a pronated grip."
    },
    {
      "stepNumber": 3,
      "description": "Pull the leg upwards while keeping the chest tall and extending the planted leg."
    },
    {
      "stepNumber": 4,
      "description": "Release the leg and slowly lower back to the starting position."
    },
    {
      "stepNumber": 5,
      "description": "Step forward and repeat the process on the opposite leg for the desired number of repetitions."
    }
