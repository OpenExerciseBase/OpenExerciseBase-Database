  "instructions": [
    {
      "stepNumber": 1,
      "description": "Close your eyes."
    },
    {
      "stepNumber": 2,
      "description": "Additionally you can put your hands on your eyelids."
    },
    {
      "stepNumber": 3,
      "description": "Look up and down from behind your eyelids."
    },
    {
      "stepNumber": 4,
      "description": "Now look to the right and to the left."
    },
    {
      "stepNumber": 5,
      "description": "Do this slowly and deliberately."
    },
    {
      "stepNumber": 6,
      "description": "Circle your gaze a few times."
    },
    {
      "stepNumber": 7,
      "description": "Keep your eyes very still for a moment before you open them again."
    }
  ],
